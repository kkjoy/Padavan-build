SRC_NAME = openssl-3.4.0
SRC_URL = https://www.openssl.org/source/openssl-3.4.0.tar.gz
THISDIR = $(shell pwd)

# OpenSSL 编译选项
OPENSSL_CONFIG = linux-elf no-shared no-dso no-tests no-apps no-docs
OPENSSL_CFLAGS = -O3

all: download_test extract_test config_test
	cd $(SRC_NAME) && \
	./Configure $(OPENSSL_CONFIG) && \
	$(MAKE) -j$$(nproc)

download_test:
	( if [ ! -f $(SRC_NAME).tar.gz ]; then \
		wget -t5 --timeout=20 --no-check-certificate -O $(SRC_NAME).tar.gz $(SRC_URL); \
	fi )

extract_test:
	( if [ ! -d $(SRC_NAME) ]; then \
		tar zxf $(SRC_NAME).tar.gz ; \
	fi )

config_test:
	( if [ -f ./config_done ]; then \
		echo "the same configuration"; \
	else \
		touch config_done; \
	fi )

clean:
	if [ -d $(SRC_NAME) ] ; then \
		cd $(SRC_NAME) && make clean ; \
	fi ; \
	rm -f config_done

romfs:
	# OpenSSL 3 动态库
	-$(ROMFSINST) $(THISDIR)/$(SRC_NAME)/libssl.so.3 /usr/lib/libssl.so.3
	-$(ROMFSINST) $(THISDIR)/$(SRC_NAME)/libcrypto.so.3 /usr/lib/libcrypto.so.3
	# 创建软链接
	ln -sf libssl.so.3 $(THISDIR)/$(SRC_NAME)/libssl.so
	ln -sf libcrypto.so.3 $(THISDIR)/$(SRC_NAME)/libcrypto.so
	-$(ROMFSINST) $(THISDIR)/$(SRC_NAME)/libssl.so /usr/lib/libssl.so
	-$(ROMFSINST) $(THISDIR)/$(SRC_NAME)/libcrypto.so /usr/lib/libcrypto.so
